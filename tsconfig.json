{
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@env": ["./src/@types/env.d.ts"]
    }
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "src/**/*",
    "app/**/*",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
